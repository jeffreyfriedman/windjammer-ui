// Palette of draggable node prototypes (serialized as graph delta on drop).

use super::traits::Renderable



    pub label: string,
    pub template_key: string,
    pub accent: string,
}

impl VsPaletteEntry {
    pub fn new(label: string, template_key: string, accent: string) -> VsPaletteEntry {
        VsPaletteEntry { label, template_key, accent }
    }
}

pub struct VsPaletteSection {
    pub title: string,
    pub accent: string,
    pub entries: Vec<VsPaletteEntry>,
}

impl VsPaletteSection {
    pub fn new(title: string, accent: string) -> VsPaletteSection {
        VsPaletteSection { title, accent, entries: Vec::new() }
    }

    pub fn entry(self, e: VsPaletteEntry) -> VsPaletteSection {
        self.entries.push(e)
        self
    }
}

pub struct VisualScriptPalette {
    pub on_drag_start: string,
    pub sections: Vec<VsPaletteSection>,
}

impl VisualScriptPalette {
    pub fn default_gameplay_palette() -> VisualScriptPalette {
        let mut palette = VisualScriptPalette {
            on_drag_start: "vs_palette_drag(ev)",
            sections: Vec::new(),
        }
        palette.sections.push(
            VsPaletteSection::new("Events", "#3b82f6")
                .entry(VsPaletteEntry::new("On Start", "event_on_start", "#3b82f6"))
                .entry(VsPaletteEntry::new("On Update", "event_on_update", "#2563eb"))
                .entry(VsPaletteEntry::new("On Collision", "event_on_collision", "#1d4ed8")),
        )
        palette.sections.push(
            VsPaletteSection::new("Flow", "#ffffff")
                .entry(VsPaletteEntry::new("Branch", "branch", "#e94560"))
                .entry(VsPaletteEntry::new("Sequence", "sequence", "#94a3b8"))
                .entry(VsPaletteEntry::new("While", "while_loop", "#cbd5f5")),
        )
        palette.sections.push(
            VsPaletteSection::new("Variables", "#a855f7")
                .entry(VsPaletteEntry::new("Get Local", "get_local", "#c084fc"))
                .entry(VsPaletteEntry::new("Set Local", "set_local", "#9333ea"))
                .entry(VsPaletteEntry::new("Literal (float)", "literal_float", "#e9d5ff")),
        )
        palette.sections.push(
            VsPaletteSection::new("Math", "#4ade80")
                .entry(VsPaletteEntry::new("Add", "add_float", "#34d399"))
                .entry(VsPaletteEntry::new("Subtract", "subtract_float", "#10b981"))
                .entry(VsPaletteEntry::new("Normalize Vec3", "vec3_normalize", "#059669")),
        )
        palette.sections.push(
            VsPaletteSection::new("Game", "#fb923c")
                .entry(VsPaletteEntry::new("Spawn Entity", "spawn_entity", "#f97316"))
                .entry(VsPaletteEntry::new("Raycast", "raycast", "#ea580c"))
                .entry(VsPaletteEntry::new("Play Sound", "play_sound", "#c2410c")),
        )
        palette
    }
}

impl Renderable for VisualScriptPalette {
    pub fn render(self) -> string {
        let styles = visual_script_palette_styles()
        let mut html = ""
        html = html + "<style>" + styles + "</style>"
        html = html + "<aside class='vs-palette'><header>Node Palette</header>"
        for sec in self.sections {
            html = html + format!(
                "<section class='vs-palette-section' style='border-left: 3px solid {};'><h4>{}</h4>",
                sec.accent,
                sec.title,
            )
            for ent in sec.entries {
                html = html + format!(
                    "<button class='vs-chip' draggable='true' style='border-color:{};' data-vs-template='{}' ondragstart='{}'>{}</button>",
                    ent.accent,
                    ent.template_key,
                    self.on_drag_start,
                    ent.label,
                )
            }
            html = html + "</section>"
        }
        html = html + "</aside>"
        html
    }
}

pub fn visual_script_palette_styles() -> string {
    "
.vs-palette { width:220px; background:#111827; color:#cbd5f5; display:flex; flex-direction:column; gap:8px; padding:8px;}
.vs-palette header { font-size:13px; font-weight:700; letter-spacing:.04em;}
.vs-palette-section { background:#1e293b; border-radius:6px; padding:6px;}
.vs-palette-section h4 { margin:0 0 4px 0; font-size:11px; text-transform:uppercase;}
.vs-chip { width:100%; text-align:left; margin-bottom:4px; padding:4px 6px; border:1px solid #475569; background:#0f172a; color:#e2e8f0; cursor:grab;}
"
}
