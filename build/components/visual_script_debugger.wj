// Host UI for breakpoints, stepping, watches, highlighted execution trace.

use super::traits::Renderable

pub struct VisualScriptDebuggerPanel {
    pub step_handler: string,
    pub breakpoint_toggle_handler: string,
    pub callstack_text: string,
    pub watches_text: string,
}

impl VisualScriptDebuggerPanel {
    pub fn inactive() -> VisualScriptDebuggerPanel {
        VisualScriptDebuggerPanel {
            step_handler: "vs_step_over()",
            breakpoint_toggle_handler: "vs_toggle_break()",
            callstack_text: "(empty)",
            watches_text: "(empty)",
        }
    }
}

impl Renderable for VisualScriptDebuggerPanel {
    pub fn render(self) -> string {
        let styles = visual_script_debugger_styles()
        format!(
            "<style>{}</style>\n<div class='vs-debug'>\n<header>\n<button onclick='{}'>Step (F10)</button>\n<button class='danger' onclick='{}'>Breakpoints</button>\n</header>\n<section><h5>Call stack</h5><pre>{}</pre></section>\n<section><h5>Watch</h5><pre>{}</pre></section>\n</div>",
            styles,
            self.step_handler,
            self.breakpoint_toggle_handler,
            self.callstack_text,
            self.watches_text,
        )
    }
}

pub fn visual_script_debugger_styles() -> string {
    "
.vs-debug { background:#09090f; border-top:2px solid #e94560; color:#ecfdf5; padding:8px; font-family:monospace;}
.vs-debug header { display:flex; gap:8px; margin-bottom:6px;}
.vs-debug header button { padding:6px 10px; border-radius:4px; border:none; background:#0f3460; color:#e5e7eb;}
.vs-debug header button.danger { background:#7f1d1d;}
.vs-debug pre { white-space:pre-wrap; margin:4px 0 0 0;}
"
}
