// Counter view: renders the UI for any count value.
// The view is a pure function of its state, so the same builder serves every update.

use crate::components_wj::vnode::VNode
use crate::components_wj::button::Button
use crate::components_wj::button::ButtonVariant
use crate::components_wj::traits::RenderableVNode

/// Build the counter UI for the given count.
pub fn build_counter(count: i32) -> VNode {
    VNode::div()
        .add_class("counter")
        .child(VNode::element("h1").add_text("Count: ${count}"))
        .child(Button::new("Increment").variant(ButtonVariant::Primary).on_click("increment").to_vnode())
}

fn main() {
    let initial = build_counter(0)
    let restored = build_counter(42)
    println("Initial handle: ${initial.raw_handle()}, restored handle: ${restored.raw_handle()}")
}
