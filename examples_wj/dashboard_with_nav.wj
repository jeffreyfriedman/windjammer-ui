// Dashboard with navigation: a top bar, a side menu, and a main content area.

use crate::components_wj::vnode::VNode
use crate::components_wj::button::Button
use crate::components_wj::button::ButtonVariant
use crate::components_wj::button::ButtonSize
use crate::components_wj::text::Text
use crate::components_wj::text::TextSize
use crate::components_wj::traits::RenderableVNode

fn nav_link(label: string, route: string) -> VNode {
    VNode::element("a")
        .add_attr("href", route)
        .add_style("color: inherit; text-decoration: none; padding: 8px 12px;")
        .add_text(label)
}

fn top_bar() -> VNode {
    VNode::element("nav")
        .add_class("top-bar")
        .add_style("display: flex; align-items: center; gap: 16px; padding: 12px 24px; background: #1e1e2e; color: #fff;")
        .child(VNode::span().add_style("font-weight: bold; margin-right: auto;").add_text("Windjammer Dashboard"))
        .child(nav_link("Home", "/"))
        .child(nav_link("Analytics", "/analytics"))
        .child(nav_link("Settings", "/settings"))
}

fn side_menu() -> VNode {
    VNode::element("aside")
        .add_class("side-menu")
        .add_style("width: 220px; padding: 16px; border-right: 1px solid #e0e0e0; display: flex; flex-direction: column; gap: 8px;")
        .child(Button::new("Dashboard").variant(ButtonVariant::Primary).on_click("go_dashboard").to_vnode())
        .child(Button::new("Projects").variant(ButtonVariant::Ghost).on_click("go_projects").to_vnode())
        .child(Button::new("Team").variant(ButtonVariant::Ghost).on_click("go_team").to_vnode())
        .child(Button::new("Settings").variant(ButtonVariant::Ghost).on_click("go_settings").to_vnode())
}

fn progress_bar(label: string, percent: i32) -> VNode {
    VNode::div()
        .add_style("margin-bottom: 12px;")
        .child(Text::new("${label} (${percent}%)").size(TextSize::Small).to_vnode())
        .child(
            VNode::div()
                .add_style("background: #eee; border-radius: 4px; height: 8px;")
                .child(VNode::div().add_style("background: #1976d2; border-radius: 4px; height: 8px; width: ${percent}%;"))
        )
}

fn main_content() -> VNode {
    VNode::element("main")
        .add_style("flex: 1; padding: 24px;")
        .child(Text::new("Overview").size(TextSize::XLarge).bold().to_vnode())
        .child(progress_bar("Sprint completion", 72))
        .child(progress_bar("Test coverage", 91))
        .child(progress_bar("Storage used", 45))
        .child(
            Button::new("Refresh")
                .variant(ButtonVariant::Secondary)
                .size(ButtonSize::Small)
                .on_click("refresh")
                .to_vnode()
        )
}

/// Build the full dashboard layout as a VNode tree.
pub fn build_dashboard_with_nav() -> VNode {
    VNode::div()
        .add_style("display: flex; flex-direction: column; min-height: 100vh;")
        .child(top_bar())
        .child(
            VNode::div()
                .add_style("display: flex; flex: 1;")
                .child(side_menu())
                .child(main_content())
        )
}

fn main() {
    let ui = build_dashboard_with_nav()
    println("Dashboard with navigation built, VNode handle: ${ui.raw_handle()}")
}
