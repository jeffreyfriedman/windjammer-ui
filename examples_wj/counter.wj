// Counter Example - Simple Interactive Counter
// Demonstrates: VNode tree construction, event handler wiring, component composition

use crate::components_wj::vnode::VNode
use crate::components_wj::button::Button
use crate::components_wj::button::ButtonVariant
use crate::components_wj::button::ButtonSize
use crate::components_wj::traits::RenderableVNode

/// Build the counter UI as a VNode tree.
/// Event handlers are referenced by name; the renderer dispatches them.
pub fn build_counter_ui() -> VNode {
    VNode::div()
        .add_class("counter-app")
        .add_style("max-width: 400px; margin: 0 auto; padding: 32px; text-align: center;")
        .child(
            VNode::element("h1")
                .add_style("font-size: 24px; margin-bottom: 16px;")
                .add_text("Windjammer Counter")
        )
        .child(
            VNode::div()
                .set_id("counter-display")
                .add_style("font-size: 48px; font-weight: bold; margin: 24px 0;")
                .add_text("0")
        )
        .child(
            VNode::div()
                .add_style("display: flex; gap: 12px; justify-content: center;")
                .child(
                    Button::new("- Decrement")
                        .variant(ButtonVariant::Danger)
                        .size(ButtonSize::Large)
                        .on_click("decrement")
                        .to_vnode()
                )
                .child(
                    Button::new("+ Increment")
                        .variant(ButtonVariant::Primary)
                        .size(ButtonSize::Large)
                        .on_click("increment")
                        .to_vnode()
                )
                .child(
                    Button::new("Reset")
                        .variant(ButtonVariant::Secondary)
                        .on_click("reset")
                        .to_vnode()
                )
        )
}

fn main() {
    let ui = build_counter_ui()
    println!("Counter UI built, VNode handle: {}", ui.raw_handle())
}
