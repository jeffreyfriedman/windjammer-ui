// Todo app: a static view of a task list with an add form and filter buttons.
// Event handlers are referenced by name; the renderer dispatches them.

use crate::components_wj::vnode::VNode
use crate::components_wj::button::Button
use crate::components_wj::button::ButtonVariant
use crate::components_wj::button::ButtonSize
use crate::components_wj::checkbox::Checkbox
use crate::components_wj::container::Container
use crate::components_wj::input::Input
use crate::components_wj::text::Text
use crate::components_wj::text::TextSize
use crate::components_wj::traits::RenderableVNode

fn todo_row(label: string, done: bool, id: string) -> VNode {
    VNode::div()
        .add_class("todo-item")
        .add_style("display: flex; align-items: center; gap: 12px; padding: 8px 0;")
        .child(Checkbox::new(label).checked(done).on_change("toggle_${id}").to_vnode())
        .child(
            Button::new("Delete")
                .variant(ButtonVariant::Ghost)
                .size(ButtonSize::Small)
                .on_click("delete_${id}")
                .to_vnode()
        )
}

fn filter_bar() -> VNode {
    VNode::div()
        .add_style("display: flex; gap: 8px; margin: 16px 0;")
        .child(Button::new("All").variant(ButtonVariant::Primary).on_click("filter_all").to_vnode())
        .child(Button::new("Active").variant(ButtonVariant::Secondary).on_click("filter_active").to_vnode())
        .child(Button::new("Completed").variant(ButtonVariant::Secondary).on_click("filter_completed").to_vnode())
}

/// Build the todo UI as a VNode tree.
pub fn build_todo_ui() -> VNode {
    let add_form = VNode::div()
        .add_style("display: flex; gap: 8px;")
        .child(Input::new().placeholder("What needs to be done?").on_input("draft_changed").to_vnode())
        .child(Button::new("Add").variant(ButtonVariant::Success).on_click("add_todo").to_vnode())

    let list = VNode::div()
        .add_class("todo-list")
        .child(todo_row("Learn Windjammer", false, "1"))
        .child(todo_row("Build a UI", true, "2"))
        .child(todo_row("Ship v1.0", false, "3"))

    Container::new()
        .max_width("600px")
        .padding("24px")
        .add_child(Text::new("Todo List").size(TextSize::XLarge).bold().to_vnode())
        .add_child(add_form)
        .add_child(filter_bar())
        .add_child(list)
        .to_vnode()
}

fn main() {
    let ui = build_todo_ui()
    println("Todo UI built, VNode handle: ${ui.raw_handle()}")
}
