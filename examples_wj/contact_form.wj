// Contact form: labeled fields, a consent checkbox, and submit/reset buttons.

use crate::components_wj::vnode::VNode
use crate::components_wj::button::Button
use crate::components_wj::button::ButtonVariant
use crate::components_wj::checkbox::Checkbox
use crate::components_wj::container::Container
use crate::components_wj::input::Input
use crate::components_wj::text::Text
use crate::components_wj::text::TextSize
use crate::components_wj::traits::RenderableVNode

fn field(label: string, input: Input) -> VNode {
    VNode::div()
        .add_style("display: flex; flex-direction: column; gap: 4px; margin-bottom: 16px;")
        .child(VNode::element("label").add_text(label))
        .child(input.to_vnode())
}

/// Build the contact form as a VNode tree.
pub fn build_contact_form() -> VNode {
    let message = VNode::element("textarea")
        .add_attr("rows", "5")
        .set_placeholder("How can we help?")
        .on_input("message_changed")

    let buttons = VNode::div()
        .add_style("display: flex; gap: 12px;")
        .child(Button::new("Send").variant(ButtonVariant::Primary).on_click("submit").to_vnode())
        .child(Button::new("Reset").variant(ButtonVariant::Secondary).on_click("reset").to_vnode())

    Container::new()
        .max_width("480px")
        .padding("24px")
        .add_child(Text::new("Contact Us").size(TextSize::XLarge).bold().to_vnode())
        .add_child(field("Name", Input::new().placeholder("Your name").on_input("name_changed")))
        .add_child(field("Email", Input::new().input_type("email").placeholder("you@example.com").on_input("email_changed")))
        .add_child(
            VNode::div()
                .add_style("display: flex; flex-direction: column; gap: 4px; margin-bottom: 16px;")
                .child(VNode::element("label").add_text("Message"))
                .child(message)
        )
        .add_child(Checkbox::new("Send me a copy").on_change("copy_toggled").to_vnode())
        .add_child(buttons)
        .to_vnode()
}

fn main() {
    let ui = build_contact_form()
    println("Contact form built, VNode handle: ${ui.raw_handle()}")
}
