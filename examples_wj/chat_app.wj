// Chat app: a message history, a text input, and a send button.

use crate::components_wj::vnode::VNode
use crate::components_wj::button::Button
use crate::components_wj::button::ButtonVariant
use crate::components_wj::input::Input
use crate::components_wj::text::Text
use crate::components_wj::text::TextSize
use crate::components_wj::traits::RenderableVNode

fn message_bubble(author: string, body: string, mine: bool) -> VNode {
    let align = if mine { "flex-end" } else { "flex-start" }
    let colors = if mine { "background: #1976d2; color: #fff;" } else { "background: #eee;" }
    VNode::div()
        .add_class("chat-message")
        .add_style("align-self: ${align}; max-width: 70%; padding: 8px 12px; border-radius: 12px; ${colors}")
        .child(VNode::div().add_style("font-size: 12px; opacity: 0.7;").add_text(author))
        .child(VNode::div().add_text(body))
}

/// Build the chat UI as a VNode tree.
pub fn build_chat_ui() -> VNode {
    let history = VNode::div()
        .set_id("chat-history")
        .add_style("display: flex; flex-direction: column; gap: 8px; height: 400px; overflow-y: auto; padding: 16px;")
        .child(message_bubble("Alice", "Hi there! Ready for the demo?", false))
        .child(message_bubble("You", "Almost. One more build to run.", true))
        .child(message_bubble("Alice", "Take your time.", false))

    let composer = VNode::div()
        .add_style("display: flex; gap: 8px; padding: 12px;")
        .child(Input::new().placeholder("Type a message").on_input("draft_changed").to_vnode())
        .child(Button::new("Send").variant(ButtonVariant::Primary).on_click("send_message").to_vnode())

    VNode::div()
        .add_class("chat-app")
        .add_style("max-width: 600px; margin: 0 auto; border: 1px solid #e0e0e0; border-radius: 8px;")
        .child(Text::new("Team Chat").size(TextSize::Large).bold().to_vnode())
        .child(history)
        .child(composer)
}

fn main() {
    let ui = build_chat_ui()
    println("Chat UI built, VNode handle: ${ui.raw_handle()}")
}
