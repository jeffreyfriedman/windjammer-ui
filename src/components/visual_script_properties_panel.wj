// Inspector for the selected node's parameters (mirrors Blueprint details panel).

use super::traits::Renderable

pub struct VisualScriptPropertiesPanel {
    pub node_title: string,
    pub node_kind: string,
    pub serialized_json_fragment: string,
    pub save_handler: string,
}

impl VisualScriptPropertiesPanel {
    pub fn placeholder() -> VisualScriptPropertiesPanel {
        VisualScriptPropertiesPanel {
            node_title: "(no selection)",
            node_kind: "",
            serialized_json_fragment: "{}",
            save_handler: "vs_props_apply()",
        }
    }

    pub fn bind(self, title: string, kind: string) -> VisualScriptPropertiesPanel {
        self.node_title = title
        self.node_kind = kind
        self
    }
}

impl Renderable for VisualScriptPropertiesPanel {
    pub fn render(self) -> string {
        let styles = visual_script_properties_styles()
        format!(
            "<style>{}</style>\n<section class='vs-props'><header>Properties · {} · <code>{}</code></header>\n<label>Payload JSON</label>\n<textarea class='vs-props-json' spellcheck='false'>{}</textarea>\n<button class='vs-props-save' onclick='{}'>Apply</button></section>",
            styles,
            self.node_title,
            self.node_kind,
            self.serialized_json_fragment,
            self.save_handler,
        )
    }
}

pub fn visual_script_properties_styles() -> string {
    "
.vs-props { width:280px; background:#16213e; color:#dbeafe; padding:10px; display:flex; flex-direction:column; gap:6px;}
.vs-props header { font-size:13px;}
.vs-props-json { min-height:120px; background:#050816; border:1px solid #334155; color:#cbd5f5; font-family:monospace;}
.vs-props-save { margin-top:4px; padding:6px; border:none; border-radius:4px; background:#2563eb; color:white; cursor:pointer;}
"
}
