// Blueprint-style authoring layout: toolbar + infinite-style canvas wrapper around `node_graph.NodeGraph`.

use super::traits::Renderable
use super::node_graph::NodeGraph
use super::node_graph::node_graph_styles

pub struct VisualScriptCanvas {
    pub script_name: string,
    pub graph: NodeGraph,
    pub compile_handler: string,
    pub simulate_handler: string,
}

impl VisualScriptCanvas {
    pub fn new(script_name: string, graph: NodeGraph) -> VisualScriptCanvas {
        VisualScriptCanvas {
            script_name,
            graph,
            compile_handler: "vs_compile()",
            simulate_handler: "vs_simulate()",
        }
    }

    pub fn compile_handler(self, handler: string) -> VisualScriptCanvas {
        self.compile_handler = handler
        self
    }

    pub fn simulate_handler(self, handler: string) -> VisualScriptCanvas {
        self.simulate_handler = handler
        self
    }
}

impl Renderable for VisualScriptCanvas {
    pub fn render(self) -> string {
        let base = node_graph_styles()
        let extra = visual_script_canvas_styles()
        let body = self.graph.render()
        format!(
            "<style>{}{}</style>\n<div class='vs-shell'>\n<div class='vs-topbar'><h2>{}</h2>\n<button class='vs-action' onclick='{}'>Compile → .wj</button>\n<button class='vs-action secondary' onclick='{}'>Simulate (interp)</button></div>\n<div class='vs-canvas-host'>{}</div>\n</div>",
            base,
            extra,
            self.script_name,
            self.compile_handler,
            self.simulate_handler,
            body
        )
    }
}

pub fn visual_script_canvas_styles() -> string {
    "
.vs-shell { display:flex; flex-direction:column; height:100%; background:#050510; color:#ddd; font-family: system-ui,sans-serif;}
.vs-topbar { display:flex; align-items:center; gap:12px; padding:8px 12px; border-bottom:1px solid #1f2937;}
.vs-topbar h2 { margin:0; font-size:14px; font-weight:600; flex:1;}
.vs-action { padding:6px 10px; border-radius:6px; border:none; background:#e94560; color:#0f172a; font-weight:600; cursor:pointer;}
.vs-action.secondary { background:#0f3460; color:#e2e8f0;}
.vs-canvas-host { flex:1; position:relative; min-height:420px;}
.vs-canvas-host .node-graph { position:absolute; inset:0; width:100% !important; height:100% !important;}
"
}
