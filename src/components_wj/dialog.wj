
use super::traits::Renderable
pub struct Dialog {
    title: string,
    content: string,
    open: bool,
    width: string,
}

impl Dialog {
    pub fn new(title: string, content: string) -> Dialog {
        Dialog {
            title,
            content,
            open: false,
            width: "500px",
        }
    }

    pub fn open(self, open: bool) -> Dialog {
        self.open = open
        self
    }

    pub fn width(self, width: string) -> Dialog {
        self.width = width
        self
    }


}

impl Renderable for Dialog {
pub fn render(self) -> string {
        let display_style = if self.open { "display: flex;" } else { "display: none;" }

        "<div class='wj-dialog-overlay' style='${display_style}'>
  <div class='wj-dialog' style='max-width: ${self.width}; width: 90%;'>
    <div class='wj-dialog-header'>
      <h2>${self.title}</h2>
      <button class='wj-dialog-close'>×</button>
    </div>
    <div class='wj-dialog-content'>
      ${self.content}
    </div>
  </div>
</div>"
    }
}

fn main() {
    let dialog = Dialog::new("Confirm Action", "<p>Are you sure you want to proceed?</p>")
        .open(true)
        .width("400px")

    println("${dialog.render()}")
}


