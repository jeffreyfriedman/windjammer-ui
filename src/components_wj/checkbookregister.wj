// CheckbookRegister — Amount + Balance + Clr (LedgerKit ADR-002 / R2.6 / 1.5.1).
// Hand-maintained Rust render/runtime stays SKIP_WJ_REGEN; this .wj is the API contract for tip.

use super::traits::Renderable

pub struct CheckbookRow {
    date: string,
    num: string,
    payee: string,
    amount_html: string,
    balance_html: string,
    line_id: string,
    unmatched: bool,
    cleared: bool,
}

impl CheckbookRow {
    pub fn new(
        date: string,
        num: string,
        payee: string,
        amount_html: string,
        balance_html: string,
    ) -> CheckbookRow {
        CheckbookRow {
            date: date,
            num: num,
            payee: payee,
            amount_html: amount_html,
            balance_html: balance_html,
            line_id: "",
            unmatched: false,
            cleared: false,
        }
    }

    pub fn line_id(self, id: string) -> CheckbookRow {
        self.line_id = id
        self
    }

    pub fn unmatched(self, unmatched: bool) -> CheckbookRow {
        self.unmatched = unmatched
        self
    }

    pub fn cleared(self, cleared: bool) -> CheckbookRow {
        self.cleared = cleared
        self
    }
}

pub struct CheckbookRegister {
    account_label: string,
    empty_message: string,
    mount_id: string,
    rows: Vec<CheckbookRow>,
}

impl CheckbookRegister {
    pub fn new() -> CheckbookRegister {
        CheckbookRegister {
            account_label: "Operating cash",
            empty_message: "No register lines yet — write a check or import bank lines.",
            mount_id: "registerMount",
            rows: Vec::new(),
        }
    }

    pub fn account_label(self, label: string) -> CheckbookRegister {
        self.account_label = label
        self
    }

    pub fn empty_message(self, message: string) -> CheckbookRegister {
        self.empty_message = message
        self
    }

    pub fn mount_id(self, id: string) -> CheckbookRegister {
        self.mount_id = id
        self
    }

    pub fn row(self, row: CheckbookRow) -> CheckbookRegister {
        self.rows.push(row)
        self
    }
}

impl Renderable for CheckbookRegister {
    fn render(self) -> string {
        let mut body = ""
        if self.rows.len() == 0 {
            let msg = self.empty_message
            body = "<tr class=\"lk-empty-row\"><td colspan=\"6\" class=\"muted\">${msg}</td></tr>"
        } else {
            for r in self.rows {
                let line = "${r.line_id}"
                let payee_raw = "${r.payee}"
                let payee = if r.unmatched && line.len() > 0 {
                    "${payee_raw} <button type=\"button\" class=\"btn-link\" data-wj-register-match data-line-id=\"${line}\">Match</button>"
                } else {
                    payee_raw
                }
                let checked = if r.cleared { " checked" } else { "" }
                let clr = if line.len() == 0 {
                    ""
                } else {
                    "<input type=\"checkbox\" data-wj-bank-clear data-line-id=\"${line}\" aria-label=\"Cleared\"${checked}>"
                }
                let date = r.date
                let num = r.num
                let amount = r.amount_html
                let bal = r.balance_html
                body = "${body}<tr class=\"wj-checkbook-row\" data-line-id=\"${line}\"><td class=\"lk-clr\">${clr}</td><td>${date}</td><td>${num}</td><td>${payee}</td><td class=\"lk-num\">${amount}</td><td class=\"lk-num\">${bal}</td></tr>"
            }
        }
        let account = self.account_label
        let mount = self.mount_id
        "<div class=\"wj-checkbook-register\" data-wj-checkbook-register>\n  <div class=\"checkbook-head\">\n    <p class=\"hub-kicker\">Checkbook</p>\n    <h3 class=\"checkbook-account\">${account}</h3>\n  </div>\n  <div class=\"lk-table-scroll\">\n    <table class=\"lk-table wj-checkbook-table\" aria-label=\"Checkbook register\">\n      <thead>\n        <tr>\n          <th class=\"lk-clr\">Clr</th>\n          <th>Date</th>\n          <th>Num</th>\n          <th>Payee / memo</th>\n          <th class=\"lk-num\">Amount</th>\n          <th class=\"lk-num\">Balance</th>\n        </tr>\n      </thead>\n      <tbody id=\"${mount}\">\n        ${body}\n      </tbody>\n    </table>\n  </div>\n</div>"
    }
}
