// SplitPanel — two-pane layout (register rail + detail dogfood)

use super::traits::Renderable

pub enum SplitDirection {
    Horizontal,
    Vertical,
}

pub struct SplitPanel {
    left: string,
    right: string,
    direction: SplitDirection,
    initial_size: i32,
    class_name: string,
}

impl SplitPanel {
    pub fn new(left: string, right: string) -> SplitPanel {
        SplitPanel {
            left: left,
            right: right,
            direction: SplitDirection::Vertical,
            initial_size: 50,
            class_name: "wj-split-panel",
        }
    }

    pub fn direction(self, direction: SplitDirection) -> SplitPanel {
        self.direction = direction
        self
    }

    pub fn initial_size(self, size: i32) -> SplitPanel {
        self.initial_size = size
        self
    }

    pub fn class_name(self, class_name: string) -> SplitPanel {
        self.class_name = class_name
        self
    }
}

impl Renderable for SplitPanel {
    fn render(self) -> string {
        let flex_direction = match self.direction {
            SplitDirection::Horizontal => "column",
            SplitDirection::Vertical => "row",
        }
        let right_flex = 100 - self.initial_size
        "<div class='${self.class_name}' style='display: flex; flex-direction: ${flex_direction}; height: 100%;'><div class='wj-split-pane' style='flex: ${self.initial_size}%;'>${self.left}</div><div class='wj-split-divider'></div><div class='wj-split-pane' style='flex: ${right_flex}%;'>${self.right}</div></div>"
    }
}
