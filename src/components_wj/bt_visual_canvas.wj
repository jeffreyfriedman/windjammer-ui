// Visual BT canvas panes — pairs with ai/bt_visual_debug CSS class names.

use super::traits::Renderable

@auto
pub struct BtCanvasNode {
    pub editor_id: i32,
    pub title: string,
    pub subtitle: string,
    pub accent: string,
    pub cx: i32,
    pub cy: i32,
    pub debug_class: string,
}

@auto
pub struct BtWire {
    pub from_id: i32,
    pub to_id: i32,
}

@auto
pub struct BtCanvasModel {
    pub nodes: Vec<BtCanvasNode>,
    pub wires: Vec<BtWire>,
    pub zoom: f32,
    pub pan_x: f32,
    pub pan_y: f32,
}

impl BtCanvasModel {
    pub fn patrol_demo() -> BtCanvasModel {
        let mut nodes: Vec<BtCanvasNode> = Vec::new()
        nodes.push(BtCanvasNode {
            editor_id: 1,
            title: "Root".to_string(),
            subtitle: "sequence".to_string(),
            accent: "#4c6ef5".to_string(),
            cx: 360,
            cy: 48,
            debug_class: "bt-visual-success".to_string(),
        })
        nodes.push(BtCanvasNode {
            editor_id: 2,
            title: "patrol".to_string(),
            subtitle: "action".to_string(),
            accent: "#2f9e44".to_string(),
            cx: 140,
            cy: 168,
            debug_class: "bt-visual-success".to_string(),
        })
        nodes.push(BtCanvasNode {
            editor_id: 3,
            title: "is_enemy_near".to_string(),
            subtitle: "condition".to_string(),
            accent: "#f08c00".to_string(),
            cx: 360,
            cy: 168,
            debug_class: "bt-visual-success".to_string(),
        })
        nodes.push(BtCanvasNode {
            editor_id: 4,
            title: "chase".to_string(),
            subtitle: "action".to_string(),
            accent: "#2f9e44".to_string(),
            cx: 580,
            cy: 168,
            debug_class: "bt-visual-success".to_string(),
        })
        nodes.push(BtCanvasNode {
            editor_id: 5,
            title: "attack".to_string(),
            subtitle: "action".to_string(),
            accent: "#2f9e44".to_string(),
            cx: 800,
            cy: 168,
            debug_class: "bt-visual-running".to_string(),
        })

        let mut wires: Vec<BtWire> = Vec::new()
        wires.push(BtWire {
            from_id: 1,
            to_id: 2,
        })
        wires.push(BtWire {
            from_id: 1,
            to_id: 3,
        })
        wires.push(BtWire {
            from_id: 1,
            to_id: 4,
        })
        wires.push(BtWire {
            from_id: 1,
            to_id: 5,
        })

        BtCanvasModel {
            nodes,
            wires,
            zoom: 1.0,
            pan_x: 0.0,
            pan_y: 12.0,
        }
    }
}

impl Renderable for BtCanvasModel {
    pub fn render(self) -> string {
        let mut body = "".to_string()
        let mut i = 0
        while i < self.nodes.len() {
            let n = self.nodes[i]
            let frag = "".to_string()
            let frag = frag + "<div class='bt-node-card "
            let frag = format!("{}{} {}", frag, n.debug_class, "'")
            let frag = format!("{}{}", frag, " data-bt-node='")
            let frag = format!("{}{}", frag, n.editor_id)
            let frag = frag + "' style=\"left:"
            let frag = format!("{}{}", frag, n.cx)
            let frag = frag + "px;top:"
            let frag = format!("{}{}", frag, n.cy)
            let frag = frag + "px;border-color:"
            let frag = format!("{}{}", frag, n.accent)
            let frag = frag + ";\">"
            let frag = format!("{}{}", frag, "<div class='bt-node-head'>")
            let frag = format!("{}{}", frag, n.title)
            let frag = frag + "</div><div class='bt-node-meta'>"
            let frag = format!("{}{}", frag, n.subtitle)
            let frag = frag + "</div></div>"
            body = format!("{}{}", body, frag)
            i = i + 1
        }

        let mut svg_paths = "".to_string()
        let mut w = 0
        while w < self.wires.len() {
            let edge = self.wires[w]
            svg_paths = format!(
                "{}<path class='bt-wire' data-from=\"{}\" data-to=\"{}\" />",
                svg_paths,
                edge.from_id,
                edge.to_id
            )
            w = w + 1
        }

        let z = "".to_string() + "<div class='bt-canvas'>"
        let z = z + "<div class='bt-canvas-inner' style=\"transform: scale(" + format!("{}", self.zoom) + ") translate(" + format!("{}", self.pan_x) + "px," + format!("{}", self.pan_y) + "px);\">"
        let z = z + "<svg class='bt-wire-layer'>"
        let z = format!("{}{}", z, svg_paths)
        let z = z + "</svg><div class='bt-node-layer'>"
        let z = format!("{}{}", z, body)
        z + "</div></div></div>"
    }
}

pub fn bt_visual_canvas_styles() -> string {
    "
    .bt-canvas {
        flex: 1;
        background: radial-gradient(circle at 25% 20%, rgba(99,141,246,0.14), transparent 45%), #090b16;
        position: relative;
        overflow: hidden;
    }
    .bt-canvas-inner {
        width: 100%;
        height: 100%;
        position: absolute;
        left: 0;
        top: 0;
        transform-origin: 0 0;
    }
    .bt-wire-layer {
        position: absolute;
        inset: 0;
        stroke: rgba(255,255,255,0.28);
        fill: none;
    }
    .bt-node-layer {
        position: absolute;
        inset: 0;
        pointer-events: auto;
    }
    .bt-node-card {
        position: absolute;
        min-width: 160px;
        padding: 10px;
        border-radius: 12px;
        border: 2px solid transparent;
        background: rgba(20,26,54,0.92);
        box-shadow: 0 14px 32px rgba(0,0,0,0.45);
        color: #e8eaf5;
        font-family: 'Inter',system-ui,sans-serif;
    }
    .bt-visual-running {
        outline: 2px solid rgba(250,229,116,0.95);
        box-shadow: 0 0 18px rgba(250,229,116,0.35);
    }
    .bt-visual-success {
        outline: 2px solid rgba(78,226,154,0.65);
    }
    .bt-visual-failure {
        outline: 2px solid rgba(247,134,143,0.82);
        box-shadow: 0 0 18px rgba(247,134,143,0.42);
    }
    .bt-visual-idle {
        opacity: 0.86;
        filter: grayscale(0.2);
    }
    .bt-node-head {
        font-weight: 600;
        letter-spacing: 0.01em;
    }
    .bt-node-meta {
        font-size: 11px;
        color: #aab2d9;
        margin-top: 4px;
        text-transform: uppercase;
        letter-spacing: 0.14em;
    }
    "
}
