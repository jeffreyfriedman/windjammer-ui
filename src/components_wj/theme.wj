// Theme System - Modern editor themes for Windjammer UI
// Supports dark/light modes and custom color palettes

use super::traits::Renderable

// Editor color palette
pub struct ColorPalette {
    // Backgrounds
    pub bg_primary: string,
    pub bg_secondary: string,
    pub bg_tertiary: string,
    pub bg_elevated: string,
    
    // Text
    pub text_primary: string,
    pub text_secondary: string,
    pub text_muted: string,
    
    // Accent colors
    pub accent_primary: string,
    pub accent_secondary: string,
    pub accent_success: string,
    pub accent_warning: string,
    pub accent_error: string,
    
    // Borders
    pub border_subtle: string,
    pub border_default: string,
    
    // Axis colors (for 3D editors)
    pub axis_x: string,
    pub axis_y: string,
    pub axis_z: string,
}

impl ColorPalette {
    // Default dark theme (inspired by modern game engines)
    pub fn dark() -> ColorPalette {
        ColorPalette {
            bg_primary: "#0a0a1a",
            bg_secondary: "#16213e",
            bg_tertiary: "#1a2744",
            bg_elevated: "#1e2d4d",
            text_primary: "#e0e0e0",
            text_secondary: "#a0a0a0",
            text_muted: "#666666",
            accent_primary: "#e94560",
            accent_secondary: "#0f3460",
            accent_success: "#4ade80",
            accent_warning: "#facc15",
            accent_error: "#ef4444",
            border_subtle: "rgba(255,255,255,0.05)",
            border_default: "rgba(255,255,255,0.1)",
            axis_x: "#e94560",
            axis_y: "#4ade80",
            axis_z: "#60a5fa",
        }
    }
    
    // Light theme
    pub fn light() -> ColorPalette {
        ColorPalette {
            bg_primary: "#f5f5f5",
            bg_secondary: "#ffffff",
            bg_tertiary: "#fafafa",
            bg_elevated: "#ffffff",
            text_primary: "#1a1a2e",
            text_secondary: "#666666",
            text_muted: "#999999",
            accent_primary: "#e94560",
            accent_secondary: "#3b82f6",
            accent_success: "#22c55e",
            accent_warning: "#eab308",
            accent_error: "#dc2626",
            border_subtle: "rgba(0,0,0,0.05)",
            border_default: "rgba(0,0,0,0.1)",
            axis_x: "#dc2626",
            axis_y: "#16a34a",
            axis_z: "#2563eb",
        }
    }
    
    // High contrast theme (accessibility)
    pub fn high_contrast() -> ColorPalette {
        ColorPalette {
            bg_primary: "#000000",
            bg_secondary: "#1a1a1a",
            bg_tertiary: "#2a2a2a",
            bg_elevated: "#333333",
            text_primary: "#ffffff",
            text_secondary: "#cccccc",
            text_muted: "#888888",
            accent_primary: "#ffcc00",
            accent_secondary: "#00ffcc",
            accent_success: "#00ff00",
            accent_warning: "#ffff00",
            accent_error: "#ff0000",
            border_subtle: "rgba(255,255,255,0.2)",
            border_default: "rgba(255,255,255,0.4)",
            axis_x: "#ff6666",
            axis_y: "#66ff66",
            axis_z: "#6666ff",
        }
    }
    
    // Monokai-inspired theme
    pub fn monokai() -> ColorPalette {
        ColorPalette {
            bg_primary: "#272822",
            bg_secondary: "#3e3d32",
            bg_tertiary: "#49483e",
            bg_elevated: "#75715e",
            text_primary: "#f8f8f2",
            text_secondary: "#a6a997",
            text_muted: "#75715e",
            accent_primary: "#f92672",
            accent_secondary: "#66d9ef",
            accent_success: "#a6e22e",
            accent_warning: "#fd971f",
            accent_error: "#f92672",
            border_subtle: "rgba(255,255,255,0.05)",
            border_default: "rgba(255,255,255,0.1)",
            axis_x: "#f92672",
            axis_y: "#a6e22e",
            axis_z: "#66d9ef",
        }
    }
    
    // Nord theme
    pub fn nord() -> ColorPalette {
        ColorPalette {
            bg_primary: "#2e3440",
            bg_secondary: "#3b4252",
            bg_tertiary: "#434c5e",
            bg_elevated: "#4c566a",
            text_primary: "#eceff4",
            text_secondary: "#d8dee9",
            text_muted: "#81a1c1",
            accent_primary: "#88c0d0",
            accent_secondary: "#81a1c1",
            accent_success: "#a3be8c",
            accent_warning: "#ebcb8b",
            accent_error: "#bf616a",
            border_subtle: "rgba(255,255,255,0.05)",
            border_default: "rgba(255,255,255,0.1)",
            axis_x: "#bf616a",
            axis_y: "#a3be8c",
            axis_z: "#5e81ac",
        }
    }
}

// Full editor theme configuration
pub struct EditorTheme {
    pub name: string,
    pub palette: ColorPalette,
    pub font_family: string,
    pub font_size_base: i32,
    pub border_radius: i32,
    pub spacing_unit: i32,
    pub animation_duration: i32,
}

impl EditorTheme {
    pub fn default() -> EditorTheme {
        EditorTheme {
            name: "Windjammer Dark",
            palette: ColorPalette::dark(),
            font_family: "'Inter', 'SF Pro', -apple-system, sans-serif",
            font_size_base: 13,
            border_radius: 6,
            spacing_unit: 8,
            animation_duration: 150,
        }
    }
    
    pub fn light() -> EditorTheme {
        EditorTheme {
            name: "Windjammer Light",
            palette: ColorPalette::light(),
            font_family: "'Inter', 'SF Pro', -apple-system, sans-serif",
            font_size_base: 13,
            border_radius: 6,
            spacing_unit: 8,
            animation_duration: 150,
        }
    }
    
    pub fn monokai() -> EditorTheme {
        EditorTheme {
            name: "Monokai Pro",
            palette: ColorPalette::monokai(),
            font_family: "'Fira Code', 'JetBrains Mono', monospace",
            font_size_base: 13,
            border_radius: 4,
            spacing_unit: 8,
            animation_duration: 100,
        }
    }
    
    pub fn nord() -> EditorTheme {
        EditorTheme {
            name: "Nord",
            palette: ColorPalette::nord(),
            font_family: "'Source Sans Pro', 'Nunito', sans-serif",
            font_size_base: 14,
            border_radius: 8,
            spacing_unit: 10,
            animation_duration: 200,
        }
    }
}

impl Renderable for EditorTheme {
    pub fn render(self) -> string {
        let css = ":root { 
            --bg-primary: " + self.palette.bg_primary + ";
            --bg-secondary: " + self.palette.bg_secondary + ";
            --accent-primary: " + self.palette.accent_primary + ";
            --text-primary: " + self.palette.text_primary + ";
        }
        body {
            font-family: " + self.font_family + ";
            color: var(--text-primary);
            background: var(--bg-primary);
        }"
        css
    }
}

// Theme switcher component
pub struct ThemeSwitcher {
    pub current_theme: string,
    pub themes: Vec<string>,
    pub on_change: string,
}

impl ThemeSwitcher {
    pub fn new() -> ThemeSwitcher {
        let mut themes = Vec::new()
        themes.push("dark")
        themes.push("light")
        themes.push("monokai")
        themes.push("nord")
        themes.push("high-contrast")
        
        ThemeSwitcher {
            current_theme: "dark",
            themes,
            on_change: "",
        }
    }
    
    pub fn on_change(self, handler: string) -> ThemeSwitcher {
        self.on_change = handler
        self
    }
}

impl Renderable for ThemeSwitcher {
    pub fn render(self) -> string {
        let mut options = ""
        for t in self.themes {
            let selected = if t == self.current_theme { "selected" } else { "" }
            options = options + format!("<option value='{}' {}>{}</option>", t, selected, t)
        }
        
        format!("
            <div class='theme-switcher'>
                <label>🎨 Theme</label>
                <select onchange='{}(this.value)'>
                    {}
                </select>
            </div>
        ", self.on_change, options)
    }
}

