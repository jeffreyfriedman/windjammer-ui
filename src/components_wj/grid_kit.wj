// Data display: a sortable, filterable, paginated table and a virtualized list for very long data.
//
// DataGrid renders a native `<table>` (so screen readers get row and column semantics for free) with sortable column
// headers (`aria-sort`, a button inside each header), a filter box, a live "Showing a-b of n" status and Prev/Next
// paging. The row logic (`visible_rows`) is pure.
//
// VirtualList renders only the rows inside the viewport plus a small overscan, inside a scrollable container whose
// spacer has the full height, so ten thousand rows cost a few dozen DOM nodes. Rows carry aria-posinset/aria-setsize,
// the container is a focusable listbox and moves an active row with the arrow, Page, Home and End keys.

use super::a11y::*
use super::vnode::VNode

/// Orders two cells: numerically when both parse as numbers and `numeric` is set, otherwise as lowercase text.
pub fn compare_cells(a: string, b: string, numeric: bool) -> i32 {
    if numeric {
        let x = a.trim().parse::<f64>().unwrap_or(0.0)
        let y = b.trim().parse::<f64>().unwrap_or(0.0)
        if x < y {
            return -1
        }
        if x > y {
            return 1
        }
        return 0
    }
    let x = a.to_lowercase()
    let y = b.to_lowercase()
    if x < y {
        return -1
    }
    if x > y {
        return 1
    }
    0
}

pub struct GridColumn {
    header: string,
    numeric: bool,
}

impl GridColumn {
    pub fn text(header: string) -> GridColumn {
        GridColumn { header: header, numeric: false }
    }

    pub fn number(header: string) -> GridColumn {
        GridColumn { header: header, numeric: true }
    }
}

pub struct DataGrid {
    base: string,
    caption: string,
    columns: Vec<GridColumn>,
    rows: Vec<Vec<string>>,
    sort_col: i32,
    ascending: bool,
    filter: string,
    page: i32,
    page_size: i32,
    focus: string,
}

impl DataGrid {
    pub fn new(base: string, caption: string) -> DataGrid {
        DataGrid {
            base: base,
            caption: caption,
            columns: Vec::new(),
            rows: Vec::new(),
            sort_col: -1,
            ascending: true,
            filter: "",
            page: 1,
            page_size: 10,
            focus: "",
        }
    }

    pub fn column(self, c: GridColumn) -> DataGrid {
        self.columns.push(c)
        self
    }

    pub fn row(self, cells: Vec<string>) -> DataGrid {
        self.rows.push(cells)
        self
    }

    pub fn page_size(self, n: i32) -> DataGrid {
        self.page_size = n
        self
    }

    pub fn current_page(self) -> i32 {
        self.page
    }

    /// Indices into the row list that pass the filter, in sort order (before paging).
    pub fn matching_rows(self) -> Vec<i32> {
        let needle = self.filter.to_lowercase()
        let mut order: Vec<i32> = Vec::new()
        let mut i = 0
        while i < self.rows.len() {
            let mut hit = needle.len() == 0
            let mut c = 0
            while c < self.rows[i].len() && !hit {
                if self.rows[i][c].to_lowercase().contains(needle.as_str()) {
                    hit = true
                }
                c = c + 1
            }
            if hit {
                order.push(i as i32)
            }
            i = i + 1
        }
        if self.sort_col >= 0 {
            let col = self.sort_col as usize
            let numeric = self.columns[col].numeric
            // Stable insertion sort so equal cells keep their original order.
            let mut a = 1
            while a < order.len() {
                let mut b = a
                while b > 0 {
                    let left = self.rows[order[b - 1] as usize][col]
                    let right = self.rows[order[b] as usize][col]
                    let mut c = compare_cells(left, right, numeric)
                    if !self.ascending {
                        c = 0 - c
                    }
                    if c <= 0 {
                        break
                    }
                    let tmp = order[b - 1]
                    order[b - 1] = order[b]
                    order[b] = tmp
                    b = b - 1
                }
                a = a + 1
            }
        }
        order
    }

    pub fn page_count(self) -> i32 {
        let n = self.matching_rows().len() as i32
        if n == 0 {
            return 1
        }
        (n + self.page_size - 1) / self.page_size
    }

    /// Rows on the current page, as indices into the row list.
    pub fn visible_rows(self) -> Vec<i32> {
        let all = self.matching_rows()
        let start = (self.page - 1) * self.page_size
        let mut out: Vec<i32> = Vec::new()
        let mut k = start
        while k < start + self.page_size && k < all.len() as i32 {
            out.push(all[k as usize])
            k = k + 1
        }
        out
    }

    fn sort_by(self, col: i32) {
        if self.sort_col == col {
            if self.ascending {
                self.ascending = false
            } else {
                self.sort_col = -1
                self.ascending = true
            }
        } else {
            self.sort_col = col
            self.ascending = true
        }
        self.page = 1
        self.focus = part_id(self.base, "sort", col)
    }

    fn go(self, page: i32) {
        let last = self.page_count()
        self.page = if page < 1 { 1 } else if page > last { last } else { page }
        self.focus = ""
    }
}

impl Interactive for DataGrid {
    fn on_event(self, event: string, act: string, key: string, value: string) -> bool {
        if act == "filter" && event == "input" {
            self.filter = value
            self.page = 1
            return false
        }
        let col = act_index(act, "sort")
        if col >= 0 {
            if event == "click" || (event == "keydown" && is_activation_key(key)) {
                self.sort_by(col)
                return true
            }
            return false
        }
        let activate = event == "click" || (event == "keydown" && is_activation_key(key))
        if act == "prev" && activate {
            self.go(self.page - 1)
            return true
        }
        if act == "next" && activate {
            self.go(self.page + 1)
            return true
        }
        false
    }

    fn focus_id(self) -> string {
        self.focus
    }

    fn view(self) -> VNode {
        let rows = self.visible_rows()
        let total = self.matching_rows().len() as i32
        let first = if total == 0 { 0 } else { (self.page - 1) * self.page_size + 1 }
        let last = first + rows.len() as i32 - 1
        let filter = VNode::input()
            .add_class("wj-input")
            .set_id(part_id(self.base, "filter", 0))
            .set_type("search")
            .set_value(self.filter)
            .add_attr("aria-label", "Filter rows")
            .add_attr("aria-controls", part_id(self.base, "table", 0))
            .add_attr("data-wj-act", "filter")
        let mut head = VNode::element("tr")
        let mut c = 0
        while c < self.columns.len() as i32 {
            let sorted = c == self.sort_col
            let dir = if !sorted { "none" } else if self.ascending { "ascending" } else { "descending" }
            head = head.child(
                VNode::element("th")
                    .add_attr("scope", "col")
                    .add_attr("aria-sort", dir)
                    .child(
                        VNode::button()
                            .add_class("wj-sort")
                            .set_id(part_id(self.base, "sort", c))
                            .add_attr("type", "button")
                            .add_attr("data-wj-act", "sort:${c}")
                            .add_text(self.columns[c as usize].header)
                    )
            )
            c = c + 1
        }
        let mut body = VNode::element("tbody")
        let mut r = 0
        while r < rows.len() {
            let mut tr = VNode::element("tr")
            let cells = &self.rows[rows[r] as usize]
            let mut k = 0
            while k < cells.len() {
                tr = tr.child(VNode::element("td").add_text(cells[k]))
                k = k + 1
            }
            body = body.child(tr)
            r = r + 1
        }
        let table = VNode::element("table")
            .add_class("wj-table")
            .set_id(part_id(self.base, "table", 0))
            .add_attr("aria-rowcount", "${total}")
            .add_attr("aria-colcount", "${self.columns.len()}")
            .child(VNode::element("caption").add_text(self.caption))
            .child(VNode::element("thead").child(head))
            .child(body)
        let status = VNode::div()
            .add_class("wj-grid-status")
            .set_id(part_id(self.base, "status", 0))
            .add_attr("role", "status")
            .add_attr("aria-live", "polite")
            .add_text(if total == 0 { "No rows match" } else { "Showing ${first}-${last} of ${total}" })
        let mut prev = VNode::button()
            .add_class("wj-page")
            .set_id(part_id(self.base, "prev", 0))
            .add_attr("type", "button")
            .add_attr("data-wj-act", "prev")
            .add_text("Prev")
        if self.page <= 1 {
            prev = prev.add_attr("disabled", "true")
        }
        let mut next = VNode::button()
            .add_class("wj-page")
            .set_id(part_id(self.base, "next", 0))
            .add_attr("type", "button")
            .add_attr("data-wj-act", "next")
            .add_text("Next")
        if self.page >= self.page_count() {
            next = next.add_attr("disabled", "true")
        }
        let pager = VNode::element("nav")
            .add_class("wj-pagination")
            .add_attr("aria-label", "Table pages")
            .child(prev)
            .child(VNode::span().add_text("Page ${self.page} of ${self.page_count()}"))
            .child(next)
        VNode::div().add_class("wj-datagrid").child(filter).child(table).child(status).child(pager)
    }
}

pub struct VirtualList {
    base: string,
    label: string,
    count: i32,
    row_height: i32,
    viewport: i32,
    overscan: i32,
    scroll_top: i32,
    active: i32,
}

impl VirtualList {
    /// A list of `count` rows, each `row_height` px tall, shown through a `viewport` px tall window.
    pub fn new(base: string, label: string, count: i32, row_height: i32, viewport: i32) -> VirtualList {
        VirtualList {
            base: base,
            label: label,
            count: count,
            row_height: row_height,
            viewport: viewport,
            overscan: 3,
            scroll_top: 0,
            active: 0,
        }
    }

    pub fn active_index(self) -> i32 {
        self.active
    }

    pub fn first_rendered(self) -> i32 {
        let first = self.scroll_top / self.row_height - self.overscan
        if first < 0 { 0 } else { first }
    }

    pub fn last_rendered(self) -> i32 {
        let last = (self.scroll_top + self.viewport) / self.row_height + self.overscan
        if last >= self.count { self.count - 1 } else { last }
    }

    fn rows_per_page(self) -> i32 {
        let n = self.viewport / self.row_height
        if n < 1 { 1 } else { n }
    }

    fn move_to(self, index: i32) {
        let mut next = index
        if next < 0 {
            next = 0
        }
        if next > self.count - 1 {
            next = self.count - 1
        }
        self.active = next
        // Keep the active row inside the viewport.
        let top = next * self.row_height
        if top < self.scroll_top {
            self.scroll_top = top
        }
        if top + self.row_height > self.scroll_top + self.viewport {
            self.scroll_top = top + self.row_height - self.viewport
        }
    }
}

impl Interactive for VirtualList {
    fn on_event(self, event: string, act: string, key: string, value: string) -> bool {
        if act != "vlist" {
            return false
        }
        if event == "scroll" {
            self.scroll_top = value.parse::<i32>().unwrap_or(self.scroll_top)
            return false
        }
        if event != "keydown" {
            return false
        }
        if key == "ArrowDown" {
            self.move_to(self.active + 1)
            return true
        }
        if key == "ArrowUp" {
            self.move_to(self.active - 1)
            return true
        }
        if key == "PageDown" {
            self.move_to(self.active + self.rows_per_page())
            return true
        }
        if key == "PageUp" {
            self.move_to(self.active - self.rows_per_page())
            return true
        }
        if key == "Home" {
            self.move_to(0)
            return true
        }
        if key == "End" {
            self.move_to(self.count - 1)
            return true
        }
        false
    }

    fn focus_id(self) -> string {
        ""
    }

    fn view(self) -> VNode {
        let mut spacer = VNode::div()
            .add_style("position: relative; height: ${self.count * self.row_height}px")
        let mut i = self.first_rendered()
        let last = self.last_rendered()
        while i <= last {
            let row = VNode::div()
                .add_class("wj-vlist-row")
                .set_id(part_id(self.base, "row", i))
                .add_attr("role", "option")
                .add_attr("aria-posinset", "${i + 1}")
                .add_attr("aria-setsize", "${self.count}")
                .add_attr("aria-selected", aria_bool(i == self.active))
                .add_style("position: absolute; left: 0; right: 0; top: ${i * self.row_height}px; height: ${self.row_height}px")
                .add_text("Row ${i + 1}")
            spacer = spacer.child(row)
            i = i + 1
        }
        VNode::div()
            .add_class("wj-vlist")
            .set_id(part_id(self.base, "list", 0))
            .add_attr("role", "listbox")
            .add_attr("tabindex", "0")
            .add_attr("aria-label", self.label)
            .add_attr("aria-activedescendant", part_id(self.base, "row", self.active))
            .add_attr("data-wj-act", "vlist")
            .add_attr("data-wj-scroll-top", "${self.scroll_top}")
            .add_style("overflow: auto; height: ${self.viewport}px")
            .child(spacer)
    }
}
