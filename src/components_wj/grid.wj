
use super::traits::Renderable
pub struct Grid {
    children: Vec<string>,
    columns: i32,
    gap: string,
    padding: string,
}

impl Grid {
    pub fn new(columns: i32) -> Grid {
        Grid {
            children: Vec::new(),
            columns,
            gap: "16px",
            padding: "0",
        }
    }

    pub fn child(self, child: string) -> Grid {
        self.children.push(child)
        self
    }

    pub fn children(self, children: Vec<string>) -> Grid {
        self.children = children
        self
    }

    pub fn gap(self, gap: string) -> Grid {
        self.gap = gap
        self
    }

    pub fn padding(self, padding: string) -> Grid {
        self.padding = padding
        self
    }


}

impl Renderable for Grid {
pub fn render(self) -> string {
        let style = "display: grid; grid-template-columns: repeat(${self.columns}, 1fr); gap: ${self.gap}; padding: ${self.padding};"

        let children_html = self.children.join("\n")

        "<div class='wj-grid' style='${style}'>\n${children_html}\n</div>"
    }
}
