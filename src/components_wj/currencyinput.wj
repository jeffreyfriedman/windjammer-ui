// CurrencyInput — amount field with currency code for JE / write-check (finance dogfood P1)

use super::traits::Renderable
use super::moneydisplay::format_cents

pub struct CurrencyInput {
    name: string,
    input_id: string,
    label: string,
    currency: string,
    value_cents: int,
    required: bool,
    extra_attrs: string,
}

impl CurrencyInput {
    pub fn new() -> CurrencyInput {
        CurrencyInput {
            name: "amount".to_string(),
            input_id: "".to_string(),
            label: "".to_string(),
            currency: "USD".to_string(),
            value_cents: 0,
            required: false,
            extra_attrs: "".to_string(),
        }
    }

    pub fn name(self, name: string) -> CurrencyInput {
        self.name = name
        self
    }

    pub fn input_id(self, input_id: string) -> CurrencyInput {
        self.input_id = input_id
        self
    }

    pub fn label(self, label: string) -> CurrencyInput {
        self.label = label
        self
    }

    pub fn currency(self, currency: string) -> CurrencyInput {
        self.currency = currency
        self
    }

    pub fn value_cents(self, value_cents: int) -> CurrencyInput {
        self.value_cents = value_cents
        self
    }

    pub fn required(self, required: bool) -> CurrencyInput {
        self.required = required
        self
    }

    pub fn extra_attrs(self, extra_attrs: string) -> CurrencyInput {
        self.extra_attrs = extra_attrs
        self
    }
}

impl Renderable for CurrencyInput {
    fn render(self) -> string {
        let value = format_cents(self.value_cents)
        // No .clone() — W0005; compiler auto-clones on branch reuse (regen-unblock).
        let id = if self.input_id.len() == 0 {
            self.name
        } else {
            self.input_id
        }
        let req = if self.required {
            " required"
        } else {
            ""
        }
        let extra = if self.extra_attrs.len() == 0 {
            "".to_string()
        } else {
            " ".to_string() + self.extra_attrs
        }
        let label_html = if self.label.len() == 0 {
            "".to_string()
        } else {
            format!("<label class='wj-currency-input-label' for='{}'>{}</label>", id, self.label)
        }
        format!(
            "<div class='wj-currency-input' data-currency='{}'>{}<span class='wj-currency-input-code'>{}</span><input type='text' inputmode='decimal' class='wj-currency-input-field' id='{}' name='{}' value='{}'{}{} /></div>",
            self.currency,
            label_html,
            self.currency,
            id,
            self.name,
            value,
            extra,
            req
        )
    }
}

fn main() {
    let html = CurrencyInput::new().name("amount".to_string()).currency("USD".to_string()).value_cents(1250).render()
    println!("{}", html)
}
