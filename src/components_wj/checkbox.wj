// Checkbox component - Pure Windjammer implementation


use super::traits::Renderable
use super::traits::RenderableVNode
use super::vnode::VNode

pub enum CheckboxSize {
    Small,
    Medium,
    Large,
}

pub struct Checkbox {
    label: string,
    checked: bool,
    disabled: bool,
    size: CheckboxSize,
    change_handler: string,
}

impl Checkbox {
    pub fn new(label: string) -> Checkbox {
        Checkbox {
            label: label,
            checked: false,
            disabled: false,
            size: CheckboxSize::Medium,
            change_handler: "",
        }
    }
    
    pub fn checked(self, checked: bool) -> Checkbox {
        self.checked = checked
        self
    }
    
    pub fn disabled(self, disabled: bool) -> Checkbox {
        self.disabled = disabled
        self
    }
    
    pub fn size(self, size: CheckboxSize) -> Checkbox {
        self.size = size
        self
    }
    
    pub fn on_change(self, handler: string) -> Checkbox {
        self.change_handler = handler
        self
    }
}

impl RenderableVNode for Checkbox {
    fn to_vnode(&self) -> VNode {
        let size_class = match self.size {
            CheckboxSize::Small => "wj-checkbox-sm",
            CheckboxSize::Medium => "wj-checkbox-md",
            CheckboxSize::Large => "wj-checkbox-lg",
        }
        let label_node = VNode::element("label".to_string())
            .add_class("wj-checkbox".to_string())
            .add_class(size_class.to_string())
            .child(
                VNode::input()
                    .set_type("checkbox".to_string())
                    .add_attr("checked".to_string(), if self.checked { "true" } else { "false" }.to_string())
                    .set_disabled(self.disabled)
            )
            .child(
                VNode::span()
                    .add_text(self.label.clone())
            )
        if self.change_handler.len() > 0 {
            label_node = label_node.on_change(self.change_handler.clone())
        }
        label_node
    }
}

impl Renderable for Checkbox {
pub fn render(self) -> string {
        let size_class = match self.size {
            CheckboxSize::Small => "sm",
            CheckboxSize::Medium => "md",
            CheckboxSize::Large => "lg",
        }
        
        let checked_attr = if self.checked { " checked" } else { "" }
        let disabled_attr = if self.disabled { " disabled" } else { "" }
        
        format!("<label class='wj-checkbox wj-checkbox-{}'><input type='checkbox'{}{}/><span>{}</span></label>",
                size_class, checked_attr, disabled_attr, self.label)
    }
}

fn main() {
    let cb1 = Checkbox::new("Accept terms".to_string()).checked(true)
    let cb2 = Checkbox::new("Subscribe".to_string()).size(CheckboxSize::Large).disabled(true)
    
    println!("{}", cb1.render())
    println!("{}", cb2.render())
}

