// Input component - Pure Windjammer implementation

use super::traits::Renderable
use super::traits::RenderableVNode
use super::vnode::VNode

pub struct Input {
    value: string,
    placeholder: string,
    input_type: string,
    change_handler: string,
    input_handler: string,
}

impl Input {
    pub fn new() -> Input {
        Input {
            value: "".to_string(),
            placeholder: "".to_string(),
            input_type: "text".to_string(),
            change_handler: "",
            input_handler: "",
        }
    }
    
    pub fn value(self, value: string) -> Input {
        self.value = value
        self
    }
    
    pub fn placeholder(self, placeholder: string) -> Input {
        self.placeholder = placeholder
        self
    }
    
    pub fn input_type(self, input_type: string) -> Input {
        self.input_type = input_type
        self
    }
    
    pub fn on_change(self, handler: string) -> Input {
        self.change_handler = handler
        self
    }
    
    pub fn on_input(self, handler: string) -> Input {
        self.input_handler = handler
        self
    }
}

impl RenderableVNode for Input {
    fn to_vnode(&self) -> VNode {
        let node = VNode::input()
            .add_class("wj-input".to_string())
            .set_type(self.input_type.clone())
            .set_value(self.value.clone())
            .set_placeholder(self.placeholder.clone())
        if self.change_handler.len() > 0 {
            node = node.on_change(self.change_handler.clone())
        }
        if self.input_handler.len() > 0 {
            node = node.on_input(self.input_handler.clone())
        }
        node
    }
}

impl Renderable for Input {
    fn render(self) -> string {
        format!("<input class='wj-input' type='{}' value='{}' placeholder='{}'/>", 
                self.input_type, self.value, self.placeholder)
    }
}

fn main() {
    let input = Input::new()
        .value("Hello".to_string())
        .placeholder("Enter text...".to_string())
    
    println!("{}", input.render())
}

