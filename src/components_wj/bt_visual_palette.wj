use super::traits::Renderable

@auto
pub struct BtPalettePanel {}

impl Renderable for BtPalettePanel {
    pub fn render(self) -> string {
        let mut mk = "".to_string()
        mk = mk + "<div class=\"bt-pane-label\">Compositor</div>"
        mk = mk + "<button class=\"bt-drag-chip\" draggable=\"true\" data-bt-kind=\"sequence\">Sequence</button>"
        mk = mk + "<button class=\"bt-drag-chip\" draggable=\"true\" data-bt-kind=\"selector\">Selector</button>"
        mk = mk + "<button class=\"bt-drag-chip\" draggable=\"true\" data-bt-kind=\"parallel\">Parallel</button>"
        mk = mk + "<div class=\"bt-pane-label\">Decorators</div>"
        mk = mk + "<button class=\"bt-drag-chip\" draggable=\"true\" data-bt-kind=\"inverter\">Inverter</button>"
        mk = mk + "<button class=\"bt-drag-chip\" draggable=\"true\" data-bt-kind=\"repeater\">Repeater</button>"
        mk = mk + "<button class=\"bt-drag-chip\" draggable=\"true\" data-bt-kind=\"until_fail\">Until Fail</button>"
        mk = mk + "<div class=\"bt-pane-label\">Leaves</div>"
        mk = mk + "<button class=\"bt-drag-chip\" draggable=\"true\" data-bt-kind=\"condition\">Condition</button>"
        mk = mk + "<button class=\"bt-drag-chip\" draggable=\"true\" data-bt-kind=\"action\">Action</button>"
        mk = mk + "<p class=\"bt-hint\">Drag onto the canvas grid. Host tooling wires callbacks to Rust/Windjammer delegates.</p>"
        let mut shell = "".to_string()
        shell = shell + "<aside class=\"bt-palette-pane\">"
        shell = format!("{}{}", shell, mk)
        shell + "</aside>"
    }
}

pub fn bt_visual_palette_styles() -> string {
    "
    .bt-palette-pane {
        width: 236px;
        border-right: 1px solid rgba(255,255,255,0.08);
        background: rgba(9,13,34,0.96);
        color: #e5e9ff;
        padding: 14px;
        overflow-y: auto;
    }
    .bt-pane-label {
        font-size: 11px;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: #7580b3;
        margin: 14px 0 8px 0;
    }
    .bt-drag-chip {
        display: flex;
        width: 100%;
        margin-bottom: 6px;
        padding: 8px;
        border-radius: 10px;
        border: 1px solid rgba(118,146,255,0.4);
        background: rgba(32,43,103,0.55);
        color: inherit;
        cursor: grab;
        text-align: left;
    }
    .bt-hint {
        font-size: 11px;
        line-height: 1.35;
        color: #7580b3;
        margin-top: 16px;
    }
    "
}
