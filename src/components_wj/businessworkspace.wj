// BusinessWorkspace — single pane of glass + tabbed preference (ADR-002 / R1).
// Runtime layout toggle is Rust-only until codegen supports framework JS helpers.

use super::traits::Renderable

pub struct BusinessWorkspace {
    layout: string,
    rail_html: string,
    register_html: string,
    write_check_html: string,
    memorized_html: string,
    active_tab: string,
}

impl BusinessWorkspace {
    pub fn new() -> BusinessWorkspace {
        BusinessWorkspace {
            layout: "pane".to_string(),
            rail_html: "".to_string(),
            register_html: "".to_string(),
            write_check_html: "".to_string(),
            memorized_html: "".to_string(),
            active_tab: "register".to_string(),
        }
    }

    pub fn layout(self, layout: string) -> BusinessWorkspace {
        self.layout = layout
        self
    }

    pub fn rail_html(self, html: string) -> BusinessWorkspace {
        self.rail_html = html
        self
    }

    pub fn register_html(self, html: string) -> BusinessWorkspace {
        self.register_html = html
        self
    }

    pub fn write_check_html(self, html: string) -> BusinessWorkspace {
        self.write_check_html = html
        self
    }

    pub fn memorized_html(self, html: string) -> BusinessWorkspace {
        self.memorized_html = html
        self
    }

    pub fn active_tab(self, id: string) -> BusinessWorkspace {
        self.active_tab = id
        self
    }
}

impl Renderable for BusinessWorkspace {
    fn render(self) -> string {
        if self.layout == "tabs" {
            let reg_display = if self.active_tab == "register" { "block" } else { "none" }
            let write_display = if self.active_tab == "write" { "block" } else { "none" }
            let mem_display = if self.active_tab == "memorized" { "block" } else { "none" }
            return "<div class=\"wj-business-workspace\" data-layout=\"tabs\" data-wj-business-workspace>".to_string()
                + "<div class=\"wj-bw-layout-toggle\" data-wj-bw-layout-toggle></div>"
                + "<div class=\"wj-bw-tabbar\" role=\"tablist\">"
                + "<button type=\"button\" class=\"wj-bw-tab\" data-wj-bw-tab=\"register\">Checkbook</button>"
                + "<button type=\"button\" class=\"wj-bw-tab\" data-wj-bw-tab=\"write\">Write check</button>"
                + "<button type=\"button\" class=\"wj-bw-tab\" data-wj-bw-tab=\"memorized\">Memorized</button>"
                + "</div>"
                + "<div class=\"wj-bw-tab-panes\">"
                + "<div class=\"wj-bw-pane\" data-tab=\"register\" style=\"display:"
                + reg_display
                + "\">"
                + self.rail_html
                + self.register_html
                + "</div>"
                + "<div class=\"wj-bw-pane\" data-tab=\"write\" style=\"display:"
                + write_display
                + "\">"
                + self.write_check_html
                + "</div>"
                + "<div class=\"wj-bw-pane\" data-tab=\"memorized\" style=\"display:"
                + mem_display
                + "\">"
                + self.memorized_html
                + "</div>"
                + "</div></div>"
        }
        "<div class=\"wj-business-workspace\" data-layout=\"pane\" data-wj-business-workspace>".to_string()
            + "<div class=\"wj-bw-layout-toggle\" data-wj-bw-layout-toggle></div>"
            + "<aside class=\"wj-bw-rail\">"
            + self.rail_html
            + "</aside><section class=\"wj-bw-register\">"
            + self.register_html
            + "</section><section class=\"wj-bw-write\">"
            + self.write_check_html
            + "</section><section class=\"wj-bw-memorized\">"
            + self.memorized_html
            + "</section></div>"
    }
}
