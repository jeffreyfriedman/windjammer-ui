// Tabs and accordion with full keyboard and ARIA support.
//
// TabStrip follows the WAI-ARIA tabs pattern: one tab is in the tab order (roving tabindex), arrow keys move and
// select, Home/End jump, and each panel is labelled by its tab. AccordionStack follows the accordion pattern: header
// buttons expose aria-expanded and aria-controls, arrow keys move between headers, Enter/Space toggle.

use super::a11y::*
use super::vnode::VNode

pub struct TabStrip {
    base: string,
    labels: Vec<string>,
    panels: Vec<string>,
    selected: i32,
    focus: string,
}

impl TabStrip {
    pub fn new(base: string) -> TabStrip {
        TabStrip {
            base: base,
            labels: Vec::new(),
            panels: Vec::new(),
            selected: 0,
            focus: "",
        }
    }

    pub fn tab(self, label: string, panel: string) -> TabStrip {
        self.labels.push(label)
        self.panels.push(panel)
        self
    }

    pub fn selected(self, index: i32) -> TabStrip {
        self.selected = index
        self
    }

    pub fn selected_index(self) -> i32 {
        self.selected
    }

    fn pick(self, index: i32) {
        self.selected = index
        self.focus = part_id(self.base, "tab", index)
    }
}

impl Interactive for TabStrip {
    fn on_event(self, event: string, act: string, key: string, value: string) -> bool {
        let count = self.labels.len() as i32
        let index = act_index(act, "tab")
        if index < 0 {
            return false
        }
        if event == "click" {
            self.pick(index)
            return true
        }
        if event == "keydown" {
            let next = roving_next(key, index, count, false)
            if next >= 0 {
                self.pick(next)
                return true
            }
        }
        false
    }

    fn focus_id(self) -> string {
        self.focus
    }

    fn view(self) -> VNode {
        let mut list = VNode::div()
            .add_class("wj-tablist")
            .add_attr("role", "tablist")
            .add_attr("aria-orientation", "horizontal")
        let mut panels = VNode::div().add_class("wj-tabpanels")
        let mut i = 0
        while i < self.labels.len() as i32 {
            let on = i == self.selected
            let tab_id = part_id(self.base, "tab", i)
            let panel_id = part_id(self.base, "panel", i)
            let mut tab = VNode::button()
                .add_class("wj-tab")
                .set_id(tab_id)
                .add_attr("type", "button")
                .add_attr("role", "tab")
                .add_attr("aria-selected", aria_bool(on))
                .add_attr("aria-controls", panel_id)
                .add_attr("tabindex", roving_tabindex(on))
                .add_attr("data-wj-act", "tab:${i}")
                .add_text(self.labels[i as usize])
            list = list.child(tab)
            let mut panel = VNode::div()
                .add_class("wj-tabpanel")
                .set_id(panel_id)
                .add_attr("role", "tabpanel")
                .add_attr("aria-labelledby", tab_id)
                .add_attr("tabindex", "0")
                .add_text(self.panels[i as usize])
            if !on {
                panel = panel.add_attr("hidden", "hidden")
            }
            panels = panels.child(panel)
            i = i + 1
        }
        VNode::div().add_class("wj-tabs").child(list).child(panels)
    }
}

pub struct AccordionStack {
    base: string,
    titles: Vec<string>,
    bodies: Vec<string>,
    open: Vec<bool>,
    exclusive: bool,
    focus: string,
}

impl AccordionStack {
    pub fn new(base: string) -> AccordionStack {
        AccordionStack {
            base: base,
            titles: Vec::new(),
            bodies: Vec::new(),
            open: Vec::new(),
            exclusive: false,
            focus: "",
        }
    }

    pub fn item(self, title: string, body: string) -> AccordionStack {
        self.titles.push(title)
        self.bodies.push(body)
        self.open.push(false)
        self
    }

    /// At most one section open at a time.
    pub fn exclusive(self, on: bool) -> AccordionStack {
        self.exclusive = on
        self
    }

    pub fn is_open(self, index: i32) -> bool {
        self.open[index as usize]
    }

    fn toggle(self, index: i32) {
        let was = self.open[index as usize]
        if self.exclusive {
            let mut j = 0
            while j < self.open.len() {
                self.open[j] = false
                j = j + 1
            }
        }
        self.open[index as usize] = !was
        self.focus = part_id(self.base, "head", index)
    }
}

impl Interactive for AccordionStack {
    fn on_event(self, event: string, act: string, key: string, value: string) -> bool {
        let count = self.titles.len() as i32
        let index = act_index(act, "head")
        if index < 0 {
            return false
        }
        if event == "click" {
            self.toggle(index)
            return true
        }
        if event == "keydown" {
            if is_activation_key(key) {
                self.toggle(index)
                return true
            }
            let next = roving_next(key, index, count, true)
            if next >= 0 {
                self.focus = part_id(self.base, "head", next)
                return true
            }
        }
        false
    }

    fn focus_id(self) -> string {
        self.focus
    }

    fn view(self) -> VNode {
        let mut root = VNode::div().add_class("wj-accordion")
        let mut i = 0
        while i < self.titles.len() as i32 {
            let on = self.open[i as usize]
            let head_id = part_id(self.base, "head", i)
            let body_id = part_id(self.base, "body", i)
            let head = VNode::button()
                .add_class("wj-accordion-head")
                .set_id(head_id)
                .add_attr("type", "button")
                .add_attr("aria-expanded", aria_bool(on))
                .add_attr("aria-controls", body_id)
                .add_attr("data-wj-act", "head:${i}")
                .add_text(self.titles[i as usize])
            let mut body = VNode::div()
                .add_class("wj-accordion-body")
                .set_id(body_id)
                .add_attr("role", "region")
                .add_attr("aria-labelledby", head_id)
                .add_text(self.bodies[i as usize])
            if !on {
                body = body.add_attr("hidden", "hidden")
            }
            root = root.child(head).child(body)
            i = i + 1
        }
        root
    }
}
