// Node graph execution trace overlay (graph debugger UI).

use super::node_graph::NodeGraph

pub fn test_apply_execution_trace_highlights_nodes() {
    let mut ids = Vec::new()
    ids.push("spawn_wave")
    ids.push("wait_delay")
    let graph = NodeGraph::new().apply_execution_trace(ids)
    assert_eq(graph.trace_node_ids.len(), 2)
}

pub fn test_trace_highlight_sets_active_class() {
    let mut node = super::node_graph::GraphNode::new("n1", "Spawn", super::node_graph::NodeCategory::Event)
    node = node.trace_highlight(true)
    assert(node.trace_active, "trace highlight flag set")
}
