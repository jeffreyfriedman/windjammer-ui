// Alert — calm status banners (finance dogfood: no emoji marks)

use super::traits::Renderable

pub enum AlertVariant {
    Error,
    Warning,
    Info,
    Success,
}

pub struct Alert {
    message: string,
    variant: AlertVariant,
    title: string,
}

impl Alert {
    pub fn error(message: string) -> Alert {
        Alert {
            message: message,
            variant: AlertVariant::Error,
            title: "".to_string(),
        }
    }

    pub fn warning(message: string) -> Alert {
        Alert {
            message: message,
            variant: AlertVariant::Warning,
            title: "".to_string(),
        }
    }

    pub fn info(message: string) -> Alert {
        Alert {
            message: message,
            variant: AlertVariant::Info,
            title: "".to_string(),
        }
    }

    pub fn success(message: string) -> Alert {
        Alert {
            message: message,
            variant: AlertVariant::Success,
            title: "".to_string(),
        }
    }

    pub fn title(self, title: string) -> Alert {
        self.title = title
        self
    }
}

fn mark_for(variant: AlertVariant) -> string {
    match variant {
        AlertVariant::Error => "Error",
        AlertVariant::Warning => "Warning",
        AlertVariant::Info => "Note",
        AlertVariant::Success => "Done",
    }
}

impl Renderable for Alert {
    fn render(self) -> string {
        let variant_class = match self.variant {
            AlertVariant::Error => "wj-alert-error",
            AlertVariant::Warning => "wj-alert-warning",
            AlertVariant::Info => "wj-alert-info",
            AlertVariant::Success => "wj-alert-success",
        }
        let mark = mark_for(self.variant)
        let heading = if self.title.len() == 0 {
            "".to_string()
        } else {
            format!("<strong class='wj-alert-title'>{}</strong>", self.title)
        }
        format!(
            "<div class='wj-alert {}' role='status'><span class='wj-alert-mark'>{}</span>{} <span class='wj-alert-msg'>{}</span></div>",
            variant_class,
            mark,
            heading,
            self.message
        )
    }
}

fn main() {
    let html = Alert::warning("Review open items".to_string()).title("Today".to_string()).render()
    println!("{}", html)
}
