
use super::traits::Renderable
pub struct ColorPicker {
    value: string,
    label: string,
}

impl ColorPicker {
    pub fn new() -> ColorPicker {
        ColorPicker {
            value: "#000000",
            label: "",
        }
    }

    pub fn value(self, value: string) -> ColorPicker {
        self.value = value
        self
    }

    pub fn label(self, label: string) -> ColorPicker {
        self.label = label
        self
    }


}

impl Renderable for ColorPicker {
pub fn render(self) -> string {
        let label_html = if self.label != "" {
            "<label>${self.label}</label>"
        } else {
            ""
        }

        "<div class='wj-color-picker'>
  ${label_html}
  <input type='color' value='${self.value}' class='wj-color-input'>
  <span class='wj-color-value'>${self.value}</span>
</div>"
    }
}

fn main() {
    let picker = ColorPicker::new()
        .value("#667eea")
        .label("Theme Color")

    println("${picker.render()}")
}


