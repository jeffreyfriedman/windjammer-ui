// DatePicker — HTML date input for forms (P0)

use super::traits::Renderable

pub struct DatePicker {
    value: string,
    label: string,
    name: string,
    required: bool,
}

impl DatePicker {
    pub fn new() -> DatePicker {
        DatePicker {
            value: "",
            label: "",
            name: "date",
            required: false,
        }
    }

    pub fn value(self, value: string) -> DatePicker {
        self.value = value
        self
    }

    pub fn label(self, label: string) -> DatePicker {
        self.label = label
        self
    }

    pub fn name(self, name: string) -> DatePicker {
        self.name = name
        self
    }

    pub fn required(self, required: bool) -> DatePicker {
        self.required = required
        self
    }
}

impl Renderable for DatePicker {
    fn render(self) -> string {
        let req = if self.required { " required" } else { "" }
        let label_html = if self.label.len() > 0 {
            "<label class='wj-datepicker-label' for='${self.name}'>${self.label}</label>"
        } else {
            ""
        }
        "<div class='wj-datepicker'>${label_html}<input class='wj-datepicker-input' type='date' id='${self.name}' name='${self.name}' value='${self.value}'${req}/></div>"
    }
}

fn main() {
    let html = DatePicker::new()
        .label("Issue date")
        .name("issue_date")
        .value("2026-07-25")
        .required(true)
        .render()
    println("${html}")
}
