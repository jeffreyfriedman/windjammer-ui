// ECS Inspector panel — entity browser + read-only component fields.
// Consumes EcsInspectorSnapshot (engine EcsInspector API wired via FFI later).

use super::ecs_inspector_model::{
    EcsComponentSection, EcsEntityRow, EcsInspectorField, EcsInspectorSnapshot,
}
use super::traits::Renderable

pub struct EcsInspectorPanel {
    pub snapshot: EcsInspectorSnapshot,
    pub refresh_handler: string,
    pub select_entity_handler: string,
}

impl EcsInspectorPanel {
    pub fn from_mock() -> EcsInspectorPanel {
        EcsInspectorPanel {
            snapshot: EcsInspectorSnapshot::mock_runtime_demo(),
            refresh_handler: "ecs_inspector_refresh()".to_string(),
            select_entity_handler: "ecs_inspector_select_entity".to_string(),
        }
    }

    pub fn empty() -> EcsInspectorPanel {
        EcsInspectorPanel {
            snapshot: EcsInspectorSnapshot::empty(),
            refresh_handler: "ecs_inspector_refresh()".to_string(),
            select_entity_handler: "ecs_inspector_select_entity".to_string(),
        }
    }

    pub fn snapshot(self, snap: EcsInspectorSnapshot) -> EcsInspectorPanel {
        self.snapshot = snap
        self
    }
}

fn entity_row_class(entity_id: i64, selected_id: Option<i64>) -> string {
    if let Some(sel) = selected_id {
        if sel == entity_id {
            return "ecs-entity-row selected".to_string()
        }
    }
    "ecs-entity-row".to_string()
}

fn render_entity_row(row: EcsEntityRow, selected_id: Option<i64>, select_handler: string) -> string {
    let row_class = entity_row_class(row.entity_id, selected_id)
    let mut badges = ""
    let mut i = 0
    while i < row.component_names.len() {
        let name = row.component_names[i]
        badges = badges + format!("<span class='ecs-comp-badge'>{}</span>", name)
        i = i + 1
    }
    format!(
        "<button type='button' class='{}' onclick=\"{}({})\">
  <span class='ecs-entity-id'>#{}</span>
  <span class='ecs-entity-badges'>{}</span>
</button>",
        row_class,
        select_handler,
        row.entity_id,
        row.entity_id,
        badges,
    )
}

fn render_entity_list(
    entities: Vec<EcsEntityRow>,
    selected_id: Option<i64>,
    select_handler: string,
) -> string {
    if entities.len() == 0 {
        return "<div class='ecs-inspector-empty'>No entities in world</div>".to_string()
    }
    let mut html = ""
    for row in entities {
        html = html + render_entity_row(row, selected_id, select_handler)
    }
    html
}

fn render_field_row(field: EcsInspectorField) -> string {
    format!(
        "<div class='ecs-field-row'>
  <label class='ecs-field-name'>{}</label>
  <input class='ecs-field-value' type='text' value='{}' readonly />
</div>",
        field.name,
        field.display_value,
    )
}

fn render_component_section(section: EcsComponentSection) -> string {
    let mut fields_html = ""
    for field in section.fields {
        fields_html = fields_html + render_field_row(field)
    }
    format!(
        "<details class='ecs-component-section' open>
  <summary class='ecs-component-title'>{}</summary>
  <div class='ecs-component-fields'>{}</div>
</details>",
        section.name,
        fields_html,
    )
}

fn render_component_pane(
    components: Vec<EcsComponentSection>,
    selected_label: string,
) -> string {
    if components.len() == 0 {
        return format!(
            "<div class='ecs-inspector-detail-empty'>
  <p class='ecs-detail-title'>{}</p>
  <p class='ecs-detail-hint'>Select an entity to view read-only component fields.</p>
</div>",
            selected_label,
        )
    }
    let mut html = format!("<p class='ecs-detail-title'>{}</p>", selected_label)
    for section in components {
        html = html + render_component_section(section)
    }
    html
}

fn selected_entity_label_from_id(selected_id: Option<i64>) -> string {
    if let Some(id) = selected_id {
        format!("Entity #{}", id)
    } else {
        "No entity selected".to_string()
    }
}

impl Renderable for EcsInspectorPanel {
    pub fn render(self) -> string {
        let styles = ecs_inspector_panel_styles()
        let entities = self.snapshot.entities
        let selected_id = self.snapshot.selected_entity_id
        let components = self.snapshot.components
        let selected_label = selected_entity_label_from_id(selected_id)
        let entity_count = entities.len()
        let entity_html = render_entity_list(entities, selected_id, self.select_entity_handler)
        let component_html = render_component_pane(components, selected_label)
        format!(
            "<style>{}</style>
<div class='ecs-inspector-panel'>
  <header class='ecs-inspector-header'>
    <h3>ECS Inspector</h3>
    <button type='button' onclick='{}'>Refresh</button>
    <span class='ecs-entity-count'>{} entities</span>
  </header>
  <div class='ecs-inspector-body'>
    <aside class='ecs-entity-list'>
      <h4>Entities</h4>
      {}
    </aside>
    <section class='ecs-component-pane'>
      {}
    </section>
  </div>
</div>",
            styles,
            self.refresh_handler,
            entity_count,
            entity_html,
            component_html,
        )
    }
}

pub fn ecs_inspector_panel_styles() -> string {
    "
.ecs-inspector-panel { background:#0f0f1a; color:#e5e7eb; padding:12px; font-family:monospace; font-size:12px; min-height:280px; }
.ecs-inspector-header { display:flex; align-items:center; gap:12px; margin-bottom:12px; border-bottom:1px solid #333; padding-bottom:8px; }
.ecs-inspector-header h3 { margin:0; flex:1; color:#a78bfa; }
.ecs-inspector-header button { background:#0f3460; color:#e5e7eb; border:none; padding:6px 10px; border-radius:4px; cursor:pointer; }
.ecs-entity-count { color:#888; font-size:11px; }
.ecs-inspector-body { display:flex; gap:12px; min-height:220px; }
.ecs-entity-list { flex:0 0 38%; background:#16213e; border-radius:6px; padding:8px; overflow-y:auto; max-height:320px; }
.ecs-entity-list h4 { margin:0 0 8px 0; color:#888; font-size:11px; text-transform:uppercase; }
.ecs-entity-row { display:flex; flex-direction:column; align-items:flex-start; width:100%; text-align:left; background:#1a1a2e; border:1px solid transparent; border-radius:4px; padding:8px; margin-bottom:6px; cursor:pointer; color:#e0e0e0; }
.ecs-entity-row:hover { border-color:#60a5fa; }
.ecs-entity-row.selected { border-color:#a78bfa; background:#1e1b4b; }
.ecs-entity-id { font-weight:600; color:#a78bfa; margin-bottom:4px; }
.ecs-entity-badges { display:flex; flex-wrap:wrap; gap:4px; }
.ecs-comp-badge { background:#0f3460; color:#93c5fd; font-size:10px; padding:2px 6px; border-radius:3px; }
.ecs-component-pane { flex:1; background:#16213e; border-radius:6px; padding:10px; overflow-y:auto; max-height:320px; }
.ecs-detail-title { margin:0 0 10px 0; color:#a78bfa; font-weight:600; }
.ecs-detail-hint { color:#666; margin:0; }
.ecs-component-section { margin-bottom:10px; border:1px solid #333; border-radius:4px; padding:6px 8px; background:#1a1a2e; }
.ecs-component-title { cursor:pointer; color:#60a5fa; font-weight:600; }
.ecs-field-row { display:flex; align-items:center; gap:8px; margin:4px 0; }
.ecs-field-name { flex:0 0 42%; color:#888; font-size:11px; }
.ecs-field-value { flex:1; background:#09090f; border:1px solid #333; border-radius:3px; color:#e5e7eb; padding:4px 6px; font-family:inherit; font-size:11px; }
.ecs-inspector-empty, .ecs-inspector-detail-empty { color:#666; padding:16px; text-align:center; }
"
}
