
use super::traits::Renderable
pub struct CollapsibleSection {
    title: string,
    content: string,
    open: bool,
}

impl CollapsibleSection {
    pub fn new(title: string, content: string) -> CollapsibleSection {
        CollapsibleSection {
            title,
            content,
            open: false,
        }
    }

    pub fn open(self, open: bool) -> CollapsibleSection {
        self.open = open
        self
    }


}

impl Renderable for CollapsibleSection {
pub fn render(self) -> string {
        let icon = if self.open { "▼" } else { "▶" }
        let content_style = if self.open { "display: block;" } else { "display: none;" }

        "<div class='wj-collapsible'>
  <div class='wj-collapsible-header'>
    <span class='wj-collapsible-icon'>${icon}</span>
    <span>${self.title}</span>
  </div>
  <div class='wj-collapsible-content' style='${content_style}'>
    ${self.content}
  </div>
</div>"
    }
}

fn main() {
    let collapsible = CollapsibleSection::new("Advanced Options", "<p>Hidden content here</p>")
        .open(true)

    println("${collapsible.render()}")
}


